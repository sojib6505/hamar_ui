<!doctype html>
<html lang="en">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title><%= title %> · HAMAR</title>
  <link rel="stylesheet" href="/css/admin.css" />
</head>
<body>
  <div class="login-wrap">
    <div class="login-card">
      <div class="brand"><span>HAMAR</span> Admin</div>
      <p class="subtitle">Log in to manage products, categories and orders.</p>
      <% if (error) { %>
        <div class="flash error"><%= error %></div>
      <% } %>
      <form method="POST" action="/admin/login">
        <div class="form-group">
          <label>Email</label>
          <input type="email" name="email" required placeholder="admin@hamar.com" />
        </div>
        <div class="form-group">
          <label>Password</label>
          <input type="password" name="password" required placeholder="••••••••" />
        </div>
        <button type="submit" class="btn accent" style="width:100%;justify-content:center;">Log In</button>
      </form>
      <p class="hint">Default (after running <code>npm run seed</code>): admin@hamar.com / hamar123</p>
    </div>
  </div>
</body>
</html>
