<div class="topbar">
  <h1 class="page-title">Categories</h1>
</div>

<div style="display:grid;grid-template-columns:1.4fr 1fr;gap:20px;align-items:start;">
  <table>
    <thead><tr><th>Name</th><th>Slug</th><th>Description</th><th></th></tr></thead>
    <tbody>
      <% categories.forEach(c => { %>
        <tr>
          <td><%= c.name %></td>
          <td><code><%= c.slug %></code></td>
          <td style="max-width:260px;overflow:hidden;text-overflow:ellipsis;white-space:nowrap;"><%= c.description %></td>
          <td class="actions">
            <form method="POST" action="/admin/categories/<%= c._id %>/delete" onsubmit="return confirm('Delete this category?')">
              <button type="submit" class="btn sm danger">Delete</button>
            </form>
          </td>
        </tr>
      <% }) %>
      <% if (categories.length === 0) { %>
        <tr><td colspan="4" style="text-align:center;color:var(--muted);">No categories yet.</td></tr>
      <% } %>
    </tbody>
  </table>

  <div class="card">
    <h3 style="margin-top:0;">Add Category</h3>
    <form method="POST" action="/admin/categories">
      <div class="form-group">
        <label>Name</label>
        <input type="text" name="name" required />
      </div>
      <div class="form-group">
        <label>Description</label>
        <textarea name="description" rows="3"></textarea>
      </div>
      <div class="form-group">
        <label>Image URL</label>
        <input type="text" name="image" placeholder="https://..." />
      </div>
      <button type="submit" class="btn accent" style="width:100%;justify-content:center;">Add Category</button>
    </form>
  </div>
</div>
