<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title><%= title %> — HAMAR</title>
  <link href="https://fonts.googleapis.com/css2?family=Sora:wght@600;700;800&family=Inter:wght@400;500;600&display=swap" rel="stylesheet">
  <link rel="stylesheet" href="/css/dashboard.css">
</head>
<body>
  <div class="login-shell">
    <div class="login-card">
      <div class="brand">HAMAR</div>
      <p class="sub">Admin Dashboard</p>

      <% if (typeof messages !== 'undefined' && messages.error && messages.error.length) { %>
        <div class="flash flash-error"><%= messages.error[0] %></div>
      <% } %>

      <form method="POST" action="/admin/login">
        <div class="form-group">
          <label>Email</label>
          <input type="email" name="email" required placeholder="admin@hamar.com" />
        </div>
        <div class="form-group">
          <label>Password</label>
          <input type="password" name="password" required placeholder="••••••••" />
        </div>
        <button type="submit" class="btn btn-accent" style="width:100%; justify-content:center;">Log In</button>
      </form>
    </div>
  </div>
</body>
</html>
