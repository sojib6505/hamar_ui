<!doctype html>
<html lang="en">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title><%= title %> · HAMAR Admin</title>
  <link rel="stylesheet" href="/css/admin.css" />
</head>
<body>
  <div class="layout">
    <aside class="sidebar">
      <a href="/admin" class="brand">HAMAR <span>ADMIN</span></a>
      <nav>
        <a href="/admin">Dashboard</a>
        <a href="/admin/products">Products</a>
        <a href="/admin/categories">Categories</a>
        <a href="/admin/orders">Orders</a>
      </nav>
      <form class="logout-form" action="/admin/logout" method="POST">
        <button type="submit">Log Out<%= adminName ? ' (' + adminName + ')' : '' %></button>
      </form>
    </aside>
    <main class="main">
      <% if (flash) { %>
        <div class="flash <%= flash.type %>"><%= flash.text %></div>
      <% } %>
      <%- body %>
    </main>
  </div>
</body>
</html>
